# Framework packaging only; this file must not change compilation or linking.
if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
  if(CMAKE_OSX_SYSROOT MATCHES "[Ii][Pp]hone[Ss]imulator")
    set(OTTER_CAD_SUPPORTED_PLATFORM "iPhoneSimulator")
    set(OTTER_CAD_PLATFORM_NAME "iphonesimulator")
  elseif(CMAKE_OSX_SYSROOT MATCHES "[Ii][Pp]hone[Oo][Ss]")
    set(OTTER_CAD_SUPPORTED_PLATFORM "iPhoneOS")
    set(OTTER_CAD_PLATFORM_NAME "iphoneos")
  else()
    message(FATAL_ERROR "OtterCADKernel requires a known iOS device or Simulator SDK")
  endif()
  if(NOT CMAKE_OSX_DEPLOYMENT_TARGET)
    message(FATAL_ERROR "OtterCADKernel requires an explicit iOS deployment target")
  endif()
  set(OTTER_CAD_MINIMUM_OS_ENTRY
      "<key>MinimumOSVersion</key>\n    <string>${CMAKE_OSX_DEPLOYMENT_TARGET}</string>")
  set(OTTER_CAD_DEVICE_FAMILY_ENTRY
      "<key>UIDeviceFamily</key>\n    <array><integer>1</integer><integer>2</integer></array>")
elseif(APPLE)
  # The macOS diagnostic framework is not a shipping iOS slice.
  set(OTTER_CAD_SUPPORTED_PLATFORM "MacOSX")
  set(OTTER_CAD_PLATFORM_NAME "macosx")
  set(OTTER_CAD_MINIMUM_OS_ENTRY "")
  set(OTTER_CAD_DEVICE_FAMILY_ENTRY "")
  if(CMAKE_OSX_DEPLOYMENT_TARGET)
    set(OTTER_CAD_MINIMUM_OS_ENTRY
        "<key>LSMinimumSystemVersion</key>\n    <string>${CMAKE_OSX_DEPLOYMENT_TARGET}</string>")
  endif()
endif()

function(_otter_cad_read_tool variable)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE _status OUTPUT_VARIABLE _value
                  OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT _status EQUAL 0 OR _value STREQUAL "")
    message(FATAL_ERROR "Unable to read actual framework build metadata: ${variable}")
  endif()
  set(${variable} "${_value}" PARENT_SCOPE)
endfunction()

if(APPLE)
  # Derive these values from the selected SDK/Xcode, never from a copied App.
  _otter_cad_read_tool(_sdk_path /usr/bin/xcrun --sdk "${OTTER_CAD_PLATFORM_NAME}" --show-sdk-path)
  _otter_cad_read_tool(OTTER_CAD_SDK_VERSION /usr/bin/xcrun --sdk "${OTTER_CAD_PLATFORM_NAME}" --show-sdk-version)
  _otter_cad_read_tool(OTTER_CAD_SDK_BUILD /usr/bin/xcrun --sdk "${OTTER_CAD_PLATFORM_NAME}" --show-sdk-build-version)
  _otter_cad_read_tool(OTTER_CAD_SDK_NAME /usr/bin/plutil -extract CanonicalName raw "${_sdk_path}/SDKSettings.plist")
  _otter_cad_read_tool(OTTER_CAD_COMPILER /usr/libexec/PlistBuddy -c "Print :DefaultProperties:DEFAULT_COMPILER" "${_sdk_path}/SDKSettings.plist")
  _otter_cad_read_tool(OTTER_CAD_PLATFORM_VERSION /usr/bin/plutil -extract Version raw "${_sdk_path}/../../../Info.plist")
  _otter_cad_read_tool(OTTER_CAD_PLATFORM_BUILD /usr/bin/plutil -extract ProductBuildVersion raw "${_sdk_path}/../../../version.plist")
  _otter_cad_read_tool(_developer_path /usr/bin/xcode-select --print-path)
  _otter_cad_read_tool(_xcode_version /usr/bin/plutil -extract CFBundleShortVersionString raw "${_developer_path}/../version.plist")
  _otter_cad_read_tool(OTTER_CAD_XCODE_BUILD /usr/bin/plutil -extract ProductBuildVersion raw "${_developer_path}/../version.plist")
  _otter_cad_read_tool(OTTER_CAD_OS_BUILD /usr/bin/sw_vers -buildVersion)
  if(NOT _xcode_version MATCHES "^([0-9]+)\\.([0-9]+)(\\.([0-9]+))?$")
    message(FATAL_ERROR "Unknown Xcode version format")
  endif()
  set(_xcode_major "${CMAKE_MATCH_1}")
  set(_xcode_minor "${CMAKE_MATCH_2}")
  set(_xcode_patch "${CMAKE_MATCH_4}")
  if(_xcode_patch STREQUAL "")
    set(_xcode_patch 0)
  endif()
  math(EXPR OTTER_CAD_XCODE_ACTUAL "${_xcode_major} * 100 + ${_xcode_minor} * 10 + ${_xcode_patch}")
endif()
