cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED OTTER_CAD_FRAMEWORK OR NOT DEFINED OTTER_CAD_SOURCE OR NOT DEFINED OTTER_CAD_PLATFORM)
  message(FATAL_ERROR "Explicit framework/source/platform is required for packaging")
endif()
get_filename_component(_framework_name "${OTTER_CAD_FRAMEWORK}" NAME)
if(NOT _framework_name STREQUAL "OtterCADKernel.framework")
  message(FATAL_ERROR "Unexpected CAD framework packaging target")
endif()
set(_license_names LICENSE_LGPL_21.txt OCCT_LGPL_EXCEPTION.txt NOTICE.txt)
if(OTTER_CAD_PLATFORM STREQUAL "iOS")
  # iOS frameworks have a flat resource layout. A directory named Resources
  # caused this Simulator's installer to reject an otherwise valid Info.plist.
  set(_resources "${OTTER_CAD_FRAMEWORK}")
  set(_legacy "${OTTER_CAD_FRAMEWORK}/Resources")
  if(EXISTS "${_legacy}")
    if(IS_SYMLINK "${_legacy}" OR NOT IS_DIRECTORY "${_legacy}")
      message(FATAL_ERROR "Unexpected legacy CAD Resources path")
    endif()
    file(GLOB _legacy_entries RELATIVE "${_legacy}" "${_legacy}/*" "${_legacy}/.[!.]*" "${_legacy}/..?*")
    foreach(_entry IN LISTS _legacy_entries)
      if(NOT _entry IN_LIST _license_names OR IS_DIRECTORY "${_legacy}/${_entry}" OR IS_SYMLINK "${_legacy}/${_entry}")
        message(FATAL_ERROR "Unexpected legacy Resources content; refuse cleanup")
      endif()
      if(_entry STREQUAL "NOTICE.txt")
        set(_source "${OTTER_CAD_SOURCE}/NOTICE.txt")
      else()
        set(_source "${OTTER_CAD_SOURCE}/OCCT/${_entry}")
      endif()
      file(SHA256 "${_legacy}/${_entry}" _old_sha)
      file(SHA256 "${_source}" _source_sha)
      if(NOT _old_sha STREQUAL _source_sha)
        message(FATAL_ERROR "Legacy license differs from exact source; refuse cleanup")
      endif()
    endforeach()
  endif()
else()
  set(_resources "${OTTER_CAD_FRAMEWORK}/Resources")
endif()
file(MAKE_DIRECTORY "${_resources}" "${OTTER_CAD_FRAMEWORK}/Modules" "${OTTER_CAD_FRAMEWORK}/Headers")
file(COPY "${OTTER_CAD_SOURCE}/OCCT/LICENSE_LGPL_21.txt" "${OTTER_CAD_SOURCE}/OCCT/OCCT_LGPL_EXCEPTION.txt"
          "${OTTER_CAD_SOURCE}/NOTICE.txt" DESTINATION "${_resources}")
file(COPY "${OTTER_CAD_SOURCE}/Bridge/include/module.modulemap" DESTINATION "${OTTER_CAD_FRAMEWORK}/Modules")
file(COPY "${OTTER_CAD_SOURCE}/Bridge/include/OtterCADKernel.h" DESTINATION "${OTTER_CAD_FRAMEWORK}/Headers")
if(OTTER_CAD_PLATFORM STREQUAL "iOS" AND EXISTS "${_legacy}")
  # Only the three checked, generated legacy copies are removed. Keep snapshots.
  foreach(_entry IN LISTS _legacy_entries)
    file(REMOVE "${_legacy}/${_entry}")
  endforeach()
  execute_process(COMMAND /bin/rmdir "${_legacy}" RESULT_VARIABLE _status)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "Legacy Resources is not empty; refuse recursive removal")
  endif()
endif()
execute_process(COMMAND /usr/bin/plutil -convert binary1 "${OTTER_CAD_FRAMEWORK}/Info.plist" RESULT_VARIABLE _status)
if(NOT _status EQUAL 0)
  message(FATAL_ERROR "Framework Info binary normalization failed")
endif()
